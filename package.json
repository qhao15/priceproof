{
  "name": "priceproof",
  "version": "0.1.0",
  "private": true,
  "description": "Price tracker and fake-discount detector for Vietnamese online electronics stores",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "dev": "pnpm build && pnpm -r --parallel --stream run \"/^dev(:.+)?$/\"",
    "db:ping": "pnpm -s --filter \"collector...\" run build && pnpm -s --filter collector run db:ping"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
