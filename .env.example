# PriceProof environment variables (SPEC §15.6).
# Copy this file to .env (never commit .env). Real environment variables win over this file.
# Empty values count as "not set".

# --- Shared ---------------------------------------------------------------
NODE_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# MongoDB Atlas dev cluster (project priceproof-dev). Required by the collector and the API.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Public URL of the web app (Render static site URL in production)
PUBLIC_WEB_URL=http://localhost:5173

# --- API ------------------------------------------------------------------
PORT=3000
# 32 or more random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_MEMBER_EMAIL=
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# --- Collector ------------------------------------------------------------
SCRAPER_USER_AGENT=PriceProofBot/1.0 (+http://localhost:5173/methodology#bot)
# false locally (pnpm dev runs the demo stores); true in .github/workflows/collect.yml
DEMO_STORES_EMBEDDED=false
DEMOMART_PUBLIC_URL=http://localhost:4000
DEMOMART_FETCH_URL=http://localhost:4000
SHOPJS_PUBLIC_URL=http://localhost:4001
SHOPJS_FETCH_URL=http://localhost:4001

# Optional AI annotation of match candidates: off until the owner chooses a provider (SPEC §8.8)
AI_MATCHING_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_CALLS_PER_DAY=200

# Email: leave SMTP_HOST empty in development to use an Ethereal test inbox (SPEC §11)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=PriceProof <alerts@example.com>

# --- Demo store -----------------------------------------------------------
DEMO_TIME_SCALE=1
DEMO_FIXED_NOW=
DEMO_FAULTS=

# --- Extension (WXT) ------------------------------------------------------
WXT_API_BASE_URL=http://localhost:3000
WXT_WEB_URL=http://localhost:5173
